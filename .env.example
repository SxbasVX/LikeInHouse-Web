# Cron Auth
CRON_SECRET="generate-with-openssl-rand-base64-32"

# Auth
# AUTH_TRUST_HOST: Solo habilitar en plataformas confiables como Vercel que controlan
# el header Host. NO habilitar si se despliega detrás de proxies que no filtran Host headers.
# En Vercel, se habilita automáticamente, no es necesario configurar manualmente.
# AUTH_TRUST_HOST="true"
# Para otros proveedores, configurar AUTH_URL explícitamente en su lugar:
# AUTH_URL="https://panel.likeinhouseperu.com"

# Admin Panel - subdomain restriction (only this hostname can access /admin)
ADMIN_HOSTNAME="panel.likeinhouseperu.com"

